{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agrotwin/scout_run",
  "title": "Verdex Scout run",
  "description": "What the robot (or its laptop bridge, or the simulator) posts. AI-generated under human review.",
  "type": "object",
  "required": ["run_id", "site_id", "mode", "robot", "sent_at", "points"],
  "properties": {
    "run_id": {"type": "string", "minLength": 3},
    "site_id": {"type": "string"},
    "mode": {"enum": ["LIVE", "REPLAY", "SIMULATED"]},
    "robot": {"type": "string"},
    "sent_at": {"type": "string"},
    "fw": {"type": "string"},
    "season_start": {"type": "string", "description": "YYYY-10-01 of the season the points belong to"},
    "truth_year": {"type": ["integer", "null"], "description": "SIMULATED only: the hidden past year the readings were generated from"},
    "points": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t"],
        "properties": {
          "t": {"type": "string"},
          "lat": {"type": ["number", "null"]},
          "lon": {"type": ["number", "null"]},
          "plot_label": {"type": ["string", "null"]},
          "soil_raw": {"type": ["number", "null"], "minimum": 0, "maximum": 5000},
          "soil_vwc_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "soil_calibration_id": {"type": ["string", "null"]},
          "air_temp_c": {"type": ["number", "null"], "minimum": -30, "maximum": 65},
          "air_rh_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "rain_flag": {"type": ["boolean", "null"]},
          "plant_health": {
            "type": ["object", "null"],
            "properties": {
              "label": {"enum": ["healthy", "diseased", "unknown"]},
              "class": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "model": {"type": "string"},
              "image_ref": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
